<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.hjug.refactorfirst</groupId>
        <artifactId>refactor-first</artifactId>
        <version>0.10.0-SNAPSHOT</version>
    </parent>

    <groupId>org.hjug.refactorfirst.costbenefitcalculator</groupId>
    <artifactId>cost-benefit-calculator</artifactId>

    <name>RefactorFirst Cost Benefit Calculator</name>

    <dependencyManagement>
        <dependencies>
            <!-- Aligns the test-scoped rewrite-kotlin dependency below
                 with the (now non-optional) compile-scope dependency
                 declared by codebase-graph-builder, so the version
                 resolves consistently. -->
            <dependency>
                <groupId>org.openrewrite.recipe</groupId>
                <artifactId>rewrite-recipe-bom</artifactId>
                <version>3.34.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Needed for PMD -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.hjug.refactorfirst.codebasegraphbuilder</groupId>
            <artifactId>codebase-graph-builder</artifactId>
        </dependency>

        <!-- Test-scope rewrite-kotlin: codebase-graph-builder now declares
             this as a compile dependency, so CycleRanker's production
             classpath already carries it transitively. This test-scoped
             declaration is retained only to pin the rewrite-recipe-bom
             (3.34.0) for version parity with the Kotlin source-path
             mapping tests in this module. -->
        <dependency>
            <groupId>org.openrewrite</groupId>
            <artifactId>rewrite-kotlin</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hjug.refactorfirst.changepronenessranker</groupId>
            <artifactId>change-proneness-ranker</artifactId>
        </dependency>

        <dependency>
            <groupId>org.hjug.refactorfirst.effortranker</groupId>
            <artifactId>effort-ranker</artifactId>
        </dependency>

        <dependency>
            <groupId>org.hjug.refactorfirst.dsm</groupId>
            <artifactId>graph-algorithms</artifactId>
        </dependency>

        <dependency>
            <groupId>org.hjug.refactorfirst.testresources</groupId>
            <artifactId>test-resources</artifactId>
        </dependency>

    </dependencies>

</project>
